# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Server-only OpenAI API key for the resort concierge chat route. Never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=sk_xxxxxxxxx
# Your inbox for new booking notifications
BOOKING_NOTIFICATION_EMAIL=you@example.com
# A verified sender address/domain in Resend
BOOKING_FROM_EMAIL=Azurea Resort <bookings@example.com>
